# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (message @userinfobot to get it)
TELEGRAM_AUTHORIZED_USER_ID=

# Blotato API (https://blotato.com)
# Get your API key from Settings > API in Blotato
BLOTATO_API_KEY=
# Get account IDs by running: curl -H "blotato-api-key: YOUR_KEY" https://backend.blotato.com/v2/users/me/accounts
BLOTATO_TIKTOK_ACCOUNT_ID=
BLOTATO_INSTAGRAM_ACCOUNT_ID=

# Webhook server
WEBHOOK_PORT=3847
WEBHOOK_SECRET=change-me-to-a-random-string
