{
  "name": "remembrance-marketing-bot",
  "version": "1.0.0",
  "description": "Telegram bot for approving Remembrance app social media posts",
  "type": "module",
  "scripts": {
    "dev": "node --no-network-family-autoselection --dns-result-order=ipv4first --import tsx/esm src/index.ts",
    "build": "tsc",
    "start": "node --no-network-family-autoselection --dns-result-order=ipv4first dist/index.js"
  },
  "dependencies": {
    "telegraf": "^4.16.3",
    "express": "^4.21.0",
    "better-sqlite3": "^11.6.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/express": "^4.17.21",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0"
  }
}
